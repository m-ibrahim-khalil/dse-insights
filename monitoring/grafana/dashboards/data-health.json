{
  "uid": "dse-data-health",
  "title": "DSE \u00b7 Data health",
  "description": "Is the data worth trusting? Freshness, volume, and the shape of the instrument universe.",
  "tags": [
    "dse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Freshness",
      "description": "Age of the newest trading day held. Rises over the weekend: the exchange trades Sunday to Thursday.",
      "datasource": {
        "type": "prometheus",
        "uid": "dse-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dse_data_freshness_days",
          "datasource": {
            "type": "prometheus",
            "uid": "dse-prometheus"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Instruments, newest day",
      "description": "Drifts as listings arrive and bonds reach maturity. Not a constant.",
      "datasource": {
        "type": "prometheus",
        "uid": "dse-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dse_instruments_latest_day",
          "datasource": {
            "type": "prometheus",
