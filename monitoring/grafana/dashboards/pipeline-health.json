        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dse_trading_days_total",
          "datasource": {
            "type": "prometheus",
            "uid": "dse-prometheus"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
