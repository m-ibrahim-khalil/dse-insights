    {
      "type": "stat",
      "title": "Price rows",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dse-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dse_price_rows_total",
          "datasource": {
            "type": "prometheus",
            "uid": "dse-prometheus"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
