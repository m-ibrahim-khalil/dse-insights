# Copy to .env, or run `make env` which creates it and generates the secrets.
# Never commit .env.

# --- Warehouse -------------------------------------------------------------
DSE_PG_HOST=localhost
DSE_PG_PORT=55432
DSE_PG_DATABASE=dse
DSE_PG_USER=dse
DSE_PG_PASSWORD=dse_local_dev

# --- Airflow ---------------------------------------------------------------
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
# Generated per clone by `make env`. Never share a real one.
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_DB_PASSWORD=
# Encrypts connections and variables held in Airflow's metadata database.
AIRFLOW_FERNET_KEY=
# Signs the tokens tasks use to call the execution API.
AIRFLOW_JWT_SECRET=
# Files written into mounted volumes are owned by this uid. `make env` sets it
# to yours, so logs written by Airflow stay readable on the host.
AIRFLOW_UID=50000

# --- Alerting --------------------------------------------------------------
# Any endpoint accepting {"text": "..."} — Slack, Discord, Teams, ntfy.
# Left blank, alerts are logged and nothing is sent anywhere.
DSE_ALERT_WEBHOOK=
# How long the same alert stays quiet after firing, in hours.
DSE_ALERT_QUIET_HOURS=6
# Days the newest captured trading day may be old before it counts as stale.
# Four allows for the Friday and Saturday the exchange is closed.
DSE_FRESHNESS_MAX_AGE_DAYS=4
# Used to build links back to a failed run.
AIRFLOW_BASE_URL=http://localhost:8080

# --- Monitoring ------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Generated per clone by `make env`. Never the image default.
GRAFANA_ADMIN_PASSWORD=
# Read-only warehouse role Grafana queries completeness with.
GRAFANA_DB_PASSWORD=
